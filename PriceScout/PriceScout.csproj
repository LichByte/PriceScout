<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <Author>haphazard</Author>
    <Name>PriceScout</Name>
    <Punchline>Check market board prices across worlds without leaving the game.</Punchline>
    <Description>Market board prices from Universalis, in game: the cheapest listing on every world in your data center or region, prices on item tooltips, and a right-click "Check Prices" option.
Also includes a watchlist with price alerts, price history charts, crafting profit, a shopping list that finds the cheapest worlds, an undercut checker for your retainers and a retainer sales log.
Use /pricescout (or /psc) to open it, or /pricescout &lt;item name&gt; to look something up.</Description>
    <Tags>market;market board;prices;universalis;retainer;undercut;crafting;economy</Tags>
    <RepoUrl>https://github.com/LichByte/PriceScout</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/LichByte/PriceScout/main/images/icon.png</IconUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dalamud shows images/icon.png next to the dll as the plugin's icon. -->
    <Content Include="..\images\icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
